<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Media Card</title>
        <style>
            @font-face {
              font-family: "CustomFont";
              src: url('{{ font | safe }}');
            }

            :root {
              /* ── 默认配色 (fallback) ── */
              --primary: #6366f1;
              --tint: rgba(99, 102, 241, 0.14);
              --bg-a: #eceef3;
              --bg-b: #e6e8ef;
              --bg-glow: rgba(99, 102, 241, 0.22);

              /* ── 通用 token ── */
              --ink: #1a1a1c;
              --ink-soft: #4b4d52;
              --ink-faint: #9498a1;
              --card: #ffffff;
              --card-glass: rgba(255, 255, 255, 0.91);
              --panel: #f5f6f9;
              --glass: rgba(255, 255, 255, 0.50);
              --hair: rgba(0, 0, 0, 0.06);
              --intro-stroke: rgba(0, 0, 0, 0.09);
              --image-stroke: rgba(255, 255, 255, 0.96);
              --grid-stroke: rgba(255, 255, 255, 0.78);
              --image-outline: rgba(0, 0, 0, 0.08);
              --grid-outline: rgba(0, 0, 0, 0.05);
              --avatar-ring: rgba(255, 255, 255, 0.92);
              --surface-highlight: rgba(255, 255, 255, 0.90);
              --border-start: #ec4899;
              --card-border-opacity: 0.72;
              --radius-card: 28px;
              --radius-img: 18px;
              --radius-panel: 18px;
              --radius-sm: 12px;
              --sans: "CustomFont", -apple-system, "SF Pro Display", "PingFang SC", "Microsoft YaHei", system-ui, "Segoe UI", sans-serif;
            }

            /* ──────── 平台主题 ──────── */
            [data-platform="bilibili"]    { --primary:#00aeec; --tint:rgba(0,174,236,0.15);  --bg-glow:rgba(0,174,236,0.24); }
            [data-platform="weibo"]       { --primary:#e6162d; --tint:rgba(230,22,45,0.13);  --bg-glow:rgba(230,22,45,0.20); }
            [data-platform="xiaohongshu"] { --primary:#ff2442; --tint:rgba(255,36,66,0.13);  --bg-glow:rgba(255,36,66,0.20); }
            [data-platform="douyin"]      { --primary:#1c1c1e; --tint:rgba(37,244,238,0.14); --bg-glow:rgba(37,244,238,0.24); }
            [data-platform="youtube"]     { --primary:#ff0000; --tint:rgba(255,0,0,0.12);    --bg-glow:rgba(255,0,0,0.18); }
            [data-platform="twitter"]     { --primary:#1d9bf0; --tint:rgba(29,155,240,0.15); --bg-glow:rgba(29,155,240,0.23); }
            [data-platform="kuaishou"]    { --primary:#ff4906; --tint:rgba(255,73,6,0.13);   --bg-glow:rgba(255,73,6,0.20); }
            [data-platform="acfun"]       { --primary:#fd4c5d; --tint:rgba(253,76,93,0.13);  --bg-glow:rgba(253,76,93,0.20); }
            [data-platform="tiktok"]      { --primary:#1c1c1e; --tint:rgba(37,244,238,0.14); --bg-glow:rgba(37,244,238,0.24); }
            [data-platform="nga"]         { --primary:#816b45; --tint:rgba(129,107,69,0.13); --bg-glow:rgba(129,107,69,0.19); }
            [data-platform="goodsmile"]   { --primary:#ff8400; --tint:rgba(255,132,0,0.14);  --bg-glow:rgba(255,132,0,0.22); }

            [data-platform=bilibili]    { --border-start: #fb7299; }
            [data-platform=weibo]       { --border-start: #ffb400; }
            [data-platform=xiaohongshu] { --border-start: #ff9bad; }
            [data-platform=douyin]      { --border-start: #fe2c55; }
            [data-platform=youtube]     { --border-start: #ffffff; }
            [data-platform=twitter]     { --border-start: #8ed8ff; }
            [data-platform=kuaishou]    { --border-start: #ffbd2e; }
            [data-platform=acfun]       { --border-start: #ff9aa4; }
            [data-platform=tiktok]      { --border-start: #fe2c55; }
            [data-platform=nga]         { --border-start: #c5ad82; }
            [data-platform=goodsmile]   { --border-start: #ffd166; }

            /* ──────── 夜间主题 (YouTube 风格深灰) ──────── */
            [data-theme="dark"] {
              --bg-a: #0f0f0f;
              --bg-b: #181818;
              --ink: #f1f1f1;
              --ink-soft: #d0d0d0;
              --ink-faint: #9b9b9b;
              --card: #212121;
              --card-glass: rgba(33, 33, 33, 0.92);
              --panel: #272727;
              --glass: rgba(33, 33, 33, 0.55);
              --hair: rgba(255, 255, 255, 0.10);
              --intro-stroke: rgba(255, 255, 255, 0.14);
              --image-stroke: rgba(255, 255, 255, 0.22);
              --grid-stroke: rgba(255, 255, 255, 0.14);
              --image-outline: rgba(255, 255, 255, 0.06);
              --grid-outline: rgba(255, 255, 255, 0.04);
              --avatar-ring: rgba(15, 15, 15, 0.92);
              --surface-highlight: rgba(255, 255, 255, 0.08);
              --card-border-opacity: 0.88;
              color-scheme: dark;
            }
            [data-theme="dark"][data-platform="douyin"],
            [data-theme="dark"][data-platform="tiktok"] {
              --primary: #25f4ee;
            }

            /* ──────── Reset ──────── */
            * { box-sizing: border-box; margin: 0; padding: 0; }

            body {
              font-family: var(--sans);
              color: var(--ink);
              width: 800px;
              padding: 14px;
              display: flex;
              justify-content: center;
              align-items: flex-start;
              -webkit-font-smoothing: antialiased;
              text-rendering: optimizeLegibility;
            }

            /* ──────── 主卡片 ──────── */
            .card {
              position: relative;
              width: 100%;
              background:
                radial-gradient(100% 68% at 10% 2%, var(--bg-glow) 0%, transparent 62%),
                radial-gradient(92% 66% at 98% 100%, var(--tint) 0%, transparent 60%),
                linear-gradient(155deg, var(--bg-a) 0%, var(--bg-b) 100%);
              border-radius: var(--radius-card);
              box-shadow:
                0 1px 0 var(--surface-highlight) inset,
                0 6px 16px rgba(0, 0, 0, 0.20),
                0 16px 40px -8px rgba(0, 0, 0, 0.24);
              padding: 22px;
              display: flex;
              flex-direction: column;
              gap: 16px;
              overflow: hidden;
            }
            /* 底部淡淡的品牌色晕染, 呼应参考图页脚 */
            .card::after {
              content: '';
              position: absolute;
              left: 0; right: 0; bottom: 0;
              height: 190px;
              background: linear-gradient(to top, var(--tint), transparent);
              pointer-events: none;
              z-index: 0;
            }
            .card::before {
              content: '';
              position: absolute;
              inset: 0;
              pointer-events: none;
              z-index: 2;
              opacity: var(--card-border-opacity);
              background:
                linear-gradient(
                  90deg,
                  transparent 0%,
                  var(--border-start) 20%,
                  var(--border-start) 42%,
                  var(--primary) 58%,
                  var(--primary) 80%,
                  transparent 100%
                ) top / calc(100% - 2 * var(--radius-card)) 2px no-repeat;
            }
            .card > * { position: relative; z-index: 1; }

            /* ──────── 顶栏: 类型胶囊 + 平台 logo ──────── */
            .top-row {
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 12px;
            }
            .platform-chip {
              display: inline-flex;
              align-items: center;
              gap: 8px;
              padding: 8px 14px;
              border-radius: 999px;
              /* 底色取品牌色淡渐变, 不要太重 */
              background: linear-gradient(135deg, var(--tint), rgba(255, 255, 255, 0));
              box-shadow: inset 0 0 0 1px var(--hair);
              color: var(--primary);
              font-size: 15px;
              font-weight: {{ font_weight }};
              letter-spacing: 0.02em;
            }
            .platform-chip svg { width: 17px; height: 17px; fill: var(--primary); display: block; }
            .platform-logo { height: 26px; width: auto; display: block; flex-shrink: 0; }
            [data-theme="dark"] .platform-logo {
              filter:
                drop-shadow(0 0 1px rgba(255, 255, 255, 0.90))
                drop-shadow(0 0 3px rgba(255, 255, 255, 0.42));
            }

            /* ──────── 视频封面 / 单图 ──────── */
            .cover-wrapper {
              position: relative;
              width: 100%;
              border-radius: var(--radius-img);
              overflow: hidden;
              border: 2px solid var(--image-stroke);
              box-shadow:
                0 0 0 1px var(--image-outline),
                0 12px 28px -7px rgba(0, 0, 0, 0.30),
                0 30px 54px -20px rgba(0, 0, 0, 0.38);
            }
            .cover-wrapper img.cover-img {
              width: 100%; height: auto;
              display: block;
              max-height: 1200px;
              object-fit: cover;
            }
            .play-button {
              position: absolute;
              top: 50%; left: 50%;
              transform: translate(-50%, -50%);
              width: 72px; height: 72px;
              display: flex;
              align-items: center;
              justify-content: center;
              background: rgba(255, 255, 255, 0.92);
              border-radius: 50%;
              pointer-events: none;
              box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
            }
            .play-button img { width: 40%; height: 40%; object-fit: contain; opacity: 0.85; }

            /* ──────── 封面下 meta 行 ──────── */
            .meta-row {
              display: flex;
              align-items: center;
              flex-wrap: wrap;
              gap: 6px 4px;
              color: var(--ink-faint);
              font-size: 15px;
              padding: 0 2px;
            }
            .meta-item {
              display: inline-flex;
              align-items: center;
              gap: 6px;
              font-variant-numeric: tabular-nums;
            }
            .meta-item svg { width: 16px; height: 16px; fill: currentColor; opacity: 0.9; }
            .meta-sep { opacity: 0.5; padding: 0 8px; }

            /* ──────── 标题 / 正文 ──────── */
            .title {
              font-size: 24px;
              font-weight: {{ font_weight }};
              color: var(--ink);
              line-height: 1.38;
              letter-spacing: -0.01em;
              white-space: pre-wrap;
              word-wrap: break-word;
              padding: 0 2px;
            }
            .text {
              font-size: 17px;
              color: var(--ink-soft);
              line-height: 1.72;
              white-space: pre-wrap;
              word-wrap: break-word;
              padding: 0 2px;
            }

            /* ──────── 作者行 ──────── */
            .author-row {
              display: flex;
              align-items: center;
              gap: 12px;
              padding: 0 2px;
            }
            .author-row .avatar {
              width: 46px; height: 46px;
              border-radius: 50%;
              object-fit: cover;
              flex-shrink: 0;
              border: 2px solid var(--primary);
              box-shadow:
                0 0 0 3px var(--avatar-ring),
                0 5px 14px -3px rgba(0, 0, 0, 0.30);
            }
            .author-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
            .author-name {
              font-size: 17px;
              font-weight: {{ font_weight }};
              color: var(--ink);
              line-height: 1.2;
            }
            .author-time { font-size: 13px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }

            /* ──────── 统计面板 (opt-in) ──────── */
            .stats-panel {
              display: flex;
              align-items: stretch;
              justify-content: space-between;
              gap: 6px;
              padding: 16px 8px;
              background: var(--glass);
              backdrop-filter: blur(18px) saturate(1.4);
              -webkit-backdrop-filter: blur(18px) saturate(1.4);
              border-radius: var(--radius-panel);
              box-shadow: inset 0 0 0 1px var(--hair);
            }
            .stat {
              flex: 1;
              display: flex;
              flex-direction: column;
              align-items: center;
              gap: 5px;
            }
            .stat-value {
              display: inline-flex;
              align-items: center;
              gap: 6px;
              font-size: 19px;
              font-weight: 700;
              color: var(--ink);
              font-variant-numeric: tabular-nums;
              line-height: 1;
            }
            .stat-value svg { width: 17px; height: 17px; fill: var(--primary); }
            .stat-label { font-size: 13px; color: var(--ink-faint); }

            /* ──────── 简介 ──────── */
            .intro {
              position: relative;
              padding: 16px 18px 16px 20px;
              background: var(--glass);
              backdrop-filter: blur(18px) saturate(1.4);
              -webkit-backdrop-filter: blur(18px) saturate(1.4);
              border: 1px solid var(--intro-stroke);
              border-radius: var(--radius-sm);
              overflow: hidden;
            }
            .intro::before {
              content: '';
              position: absolute;
              left: 0; top: 0; bottom: 0;
              width: 4px;
              background: var(--primary);
              border-radius: 4px;
            }
            .intro-text {
              font-size: 15px;
              color: var(--ink-soft);
              line-height: 1.7;
              white-space: pre-wrap;
              word-wrap: break-word;
            }

            /* ──────── 图片网格 ──────── */
            .image-container {
              width: 100%;
              border-radius: var(--radius-img);
              overflow: hidden;
              border: 2px solid var(--image-stroke);
              box-shadow:
                0 0 0 1px var(--image-outline),
                0 12px 28px -7px rgba(0, 0, 0, 0.28),
                0 28px 50px -20px rgba(0, 0, 0, 0.36);
            }
            .single-image { width: 100%; height: auto; display: block; }
            .image-grid { display: grid; gap: 12px; width: 100%; }
            .image-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
            .image-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
            .grid-item {
              position: relative;
              padding-bottom: 100%;
              background-color: var(--panel);
              overflow: hidden;
              border-radius: var(--radius-sm);
              border: 1px solid var(--grid-stroke);
              box-shadow:
                0 0 0 1px var(--grid-outline),
                0 10px 24px -7px rgba(0, 0, 0, 0.30),
                0 22px 38px -18px rgba(0, 0, 0, 0.36);
            }
            .grid-item img {
              position: absolute;
              top: 0; left: 0;
              width: 100%; height: 100%;
              object-fit: cover;
            }
            .grid-item .text {
              position: absolute;
              top: 0; left: 0;
              width: 100%; height: 100%;
              padding: 10px;
              display: flex;
              align-items: center;
              justify-content: center;
              text-align: center;
              color: var(--ink-faint);
              font-size: 17px;
              background-color: var(--panel);
            }
            .more-count {
              position: absolute;
              top: 0; left: 0;
              width: 100%; height: 100%;
              background: rgba(0, 0, 0, 0.42);
              color: #fff;
              display: flex;
              align-items: center;
              justify-content: center;
              font-size: 28px;
              font-weight: 700;
            }

            /* ──────── 推特原比例并列 (3/4图) ──────── */
            .twitter-aspect-row {
              display: flex;
              gap: 8px;
              width: 100%;
            }
            .twitter-aspect-item {
              flex: 1;
              min-width: 0;
              overflow: hidden;
              border-radius: var(--radius-sm);
              border: 1px solid var(--grid-stroke);
              box-shadow:
                0 0 0 1px var(--grid-outline),
                0 10px 24px -7px rgba(0, 0, 0, 0.30),
                0 22px 38px -18px rgba(0, 0, 0, 0.36);
            }
            .twitter-aspect-item img {
              width: 100%;
              height: auto;
              display: block;
            }

            /* ──────── 图文 ──────── */
            .graphics-item {
              display: flex;
              flex-direction: column;
              gap: 10px;
              padding: 16px;
              background: var(--panel);
              border-radius: var(--radius-sm);
            }
            .graphics-alt { font-size: 13px; color: var(--ink-faint); text-align: center; font-style: italic; }

            /* ──────── 转发 ──────── */
            .card.repost {
              background: var(--panel);
              box-shadow: inset 0 0 0 1px var(--hair);
              border-radius: var(--radius-img);
              padding: 18px;
              gap: 12px;
            }
            .card.repost::after { display: none; }
            .card.repost::before { display: none; }
            .card.repost .platform-chip { display: none; }
            .card.repost .title { font-size: 19px; }
            .card.repost .text { font-size: 15px; line-height: 1.65; }
            .card.repost .author-row .avatar { width: 38px; height: 38px; }
            .card.repost .author-name { font-size: 15px; }

            /* ──────── 页脚 ──────── */
            .footer {
              display: flex;
              align-items: center;
              justify-content: space-between;
              padding-top: 14px;
              margin-top: 2px;
              border-top: 1px solid var(--hair);
              font-size: 13px;
              color: var(--ink-faint);
            }
            .footer .src { font-variant-numeric: tabular-nums; letter-spacing: 0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70%; }
            .footer .brand { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
            .footer .brand::before {
              content: '';
              width: 7px; height: 7px;
              border-radius: 50%;
              background: var(--primary);
              display: inline-block;
            }
        </style>
    </head>
    <body data-platform="{{ result.platform.name if result.platform else '' | safe }}" data-theme="{{ theme | default('light', true) }}">
        {% autoescape true %}

        {# ── 图标库 (meta 行 & 统计面板共用) ── #}
        {% macro icon(name) %}
            {% if name == 'play' %}<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            {% elif name == 'danmaku' %}<svg viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2zm3 5v2h6V9H7zm0 4v2h4v-2H7z"/></svg>
            {% elif name == 'clock' %}<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13H11v6l5 3 .75-1.23-4.25-2.52V7z"/></svg>
            {% elif name == 'eye' %}<svg viewBox="0 0 24 24"><path d="M12 5C6.5 5 2.2 8.6 1 12c1.2 3.4 5.5 7 11 7s9.8-3.6 11-7c-1.2-3.4-5.5-7-11-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
            {% elif name == 'like' %}<svg viewBox="0 0 24 24"><path d="M2 10h4v11H2V10zm20 1.5c0-.83-.67-1.5-1.5-1.5h-5.6l.85-4.09.03-.29a1.13 1.13 0 0 0-.33-.79L14.5 4 8.6 9.9c-.37.37-.6.88-.6 1.44V19c0 1.1.9 2 2 2h8c.8 0 1.5-.5 1.8-1.2l3-7c.1-.24.15-.5.15-.8v-.5z"/></svg>
            {% elif name == 'coin' %}<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15v1h-2v-1H8v-2h2v-1H8v-1.5h2v-.8L7.5 9h1.9L12 12.2 14.6 9h1.9L13 12.7v.8h2V15h-2v1h2v2h-2z"/></svg>
            {% elif name == 'star' %}<svg viewBox="0 0 24 24"><path d="M12 17.3l-6.2 3.7 1.6-7L2 9.2l7.2-.6L12 2l2.8 6.6 7.2.6-5.4 4.8 1.6 7z"/></svg>
            {% elif name == 'share' %}<svg viewBox="0 0 24 24"><path d="M18 16.1c-.8 0-1.5.3-2 .8l-7-4a3 3 0 0 0 0-1.7l7-4c.5.5 1.2.8 2 .8a3 3 0 1 0-3-3l.1.8-7 4a3 3 0 1 0 0 4.3l7 4-.1.8a3 3 0 1 0 3-3z"/></svg>
            {% elif name == 'comment' %}<svg viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2z"/></svg>
            {% elif name == 'image' %}<svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
            {% elif name == 'feed' %}<svg viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
            {% endif %}
        {% endmacro %}

        {% macro render_card(result, is_repost=False) %}
            {% set content_type = result.content_type %}
            {% set video = result.video %}
            <div class="card {% if is_repost %}repost{% endif %}">

                {# ── 顶栏: 解析类型胶囊 (左) + 平台 logo (右) ── #}
                {% if not is_repost %}
                    {% set display_content_type = '图文' if content_type == '动态' else content_type %}
                    {% set type_icon = 'play' if content_type == '视频' else 'image' %}
                    <div class="top-row">
                        <div class="platform-chip">
                            <span>{{ display_content_type }}</span>
                            {{ icon(type_icon) }}
                        </div>
                        {% if logo %}<img class="platform-logo" src="{{ logo | safe }}" alt="{{ result.platform.display_name if result.platform else '' }}" />{% endif %}
                    </div>
                {% endif %}

                {# ── 视频封面 ── #}
                {% if video and video.cover %}
                    {% set cover_uri = (video.cover.uri if video.cover.uri else fallback_pic) %}
                    <div class="cover-wrapper">
                        <img src="{{ cover_uri | safe }}" class="cover-img" alt="cover" />
                    </div>
                {% endif %}

                {# ── 封面下 meta 行；视频时长统一按 Bilibili 样式自动补齐 ── #}
                {% set meta_items = result.extra.get('meta') or [] %}
                {% set has_duration_meta = meta_items | selectattr('icon', 'equalto', 'clock') | list | length > 0 %}
                {% set append_duration = video and video.duration and not has_duration_meta %}
                {% if not is_repost and (meta_items or append_duration) %}
                    <div class="meta-row">
                        {% for m in meta_items %}
                            <span class="meta-item">
                                {% if m.get('icon') %}{{ icon(m.get('icon')) }}{% endif %}
                                {{ m.get('text') }}
                            </span>
                            {% if not loop.last or append_duration %}<span class="meta-sep">·</span>{% endif %}
                        {% endfor %}
                        {% if append_duration %}
                            <span class="meta-item">{{ icon('clock') }}{{ video.display_duration }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── 图片网格 / 图文 (无视频时) ── #}
                {% set imgs = result.all_grid_images %}
                {% if video %}
                {% elif imgs %}
                    {% set count = imgs|length %}
                    {% set is_twitter_aspect_row = (result.platform.name == 'twitter') and (count in [3, 4]) %}
                    {% if count == 1 %}
                        {% set img = imgs[0] %}
                        <div class="image-container"><img src="{{ img.uri | safe }}" class="single-image" alt="image" /></div>
                    {% elif is_twitter_aspect_row %}
                        {# 推特3/4图: 默认显示正方形网格, JS检测为长图后切换到原比例并列 #}
                        <div class="twitter-img-grid">
                            {% set cols = 2 if count == 4 else 3 %}
                            <div class="image-grid cols-{{ cols }}">
                                {% for img in imgs %}
                                    {% set img_uri = (img.uri if img.uri else fallback_pic) %}
                                    <div class="grid-item">
                                        <img src="{{ img_uri | safe }}" alt="image" />
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="twitter-img-aspect" style="display:none">
                            <div class="twitter-aspect-row">
                                {% for img in imgs %}
                                    {% set img_uri = (img.uri if img.uri else fallback_pic) %}
                                    <div class="twitter-aspect-item">
                                        <img src="{{ img_uri | safe }}" alt="image" />
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        {% set cols = 2 if count in [2, 4] else 3 %}
                        <div class="image-grid cols-{{ cols }}">
                            {% for img in imgs[:9] %}
                                {% set img_uri = (img.uri if img.uri else fallback_pic) %}
                                <div class="grid-item">
                                    <img src="{{ img_uri | safe }}" alt="image" />
                                    {% if loop.last and count > 9 %}<div class="more-count">+{{ count - 9 }}</div>{% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% elif result.graphics %}
                    {# 图文: 标题置于正文上方 #}
                    {% if result.title %}<div class="title">{{ result.title }}</div>{% endif %}
                    {% for text_or_img in result.graphics %}
                        <div class="graphics-item">
                            {% if text_or_img is string %}
                                <div class="text">{{ text_or_img }}</div>
                            {% else %}
                                {% set img_uri = text_or_img.path_task.uri %}
                                {% set img_uri = (img_uri if img_uri else fallback_pic) %}
                                <div class="image-container"><img src="{{ img_uri | safe }}" class="single-image" alt="graphics" /></div>
                            {% endif %}
                            {% if text_or_img.alt %}<div class="graphics-alt">{{ text_or_img.alt }}</div>{% endif %}
                        </div>
                    {% endfor %}
                {% endif %}

                {# ── 标题 (头像上方); 图文已在正文上方渲染, 此处跳过避免重复 ── #}
                {% if result.title and not result.graphics %}<div class="title">{{ result.title }}</div>{% endif %}

                {# ── 转发正文 (内联, 主卡正文走下方悬浮 intro 块) ── #}
                {% if is_repost and result.text %}<div class="text">{{ result.text }}</div>{% endif %}

                {# ── 作者行 ── #}
                {% set author = result.author %}
                {% if author %}
                    <div class="author-row">
                        {% set avatar_uri = author.avatar.uri if (author.avatar and author.avatar.uri) else default_avatar %}
                        <img src="{{ avatar_uri | safe }}" class="avatar" alt="avatar" />
                        <div class="author-meta">
                            <div class="author-name">{{ author.name }}</div>
                            {% set region = result.extra.get('region') %}
                            {% if result.formartted_datetime or region %}<div class="author-time">{{ result.formartted_datetime or '' }}{% if region %}{% if result.formartted_datetime %} · {% endif %}{{ region }}{% endif %}</div>{% endif %}
                        </div>
                    </div>
                {% endif %}

                {# ── 统计面板 (opt-in: result.extra['stats'] = [{icon, value, label}, ...]) ── #}
                {% if not is_repost and result.extra.get('stats') %}
                    <div class="stats-panel">
                        {% for s in result.extra.get('stats') %}
                            <div class="stat">
                                <span class="stat-value">
                                    {% if s.get('icon') %}{{ icon(s.get('icon')) }}{% endif %}
                                    {{ s.get('value') }}
                                </span>
                                <span class="stat-label">{{ s.get('label') }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# ── 简介 (正文): 转发者文字位于被转发内容上方 ── #}
                {% if not is_repost and result.text %}
                    <div class="intro">
                        <div class="intro-text">{{ result.text }}</div>
                    </div>
                {% endif %}

                {# ── 转发 ── #}
                {% if result.repost %}{{ render_card(result.repost, is_repost=True) }}{% endif %}

                {# ── 页脚 ── #}
                {% if not is_repost %}
                    <div class="footer">
                        <span class="src">{{ result.extra.get('source_id') or result.url or '' }}</span>
                        <span class="brand">{{ footer_brand }}</span>
                    </div>
                {% endif %}
            </div>
        {% endmacro %}
        {{ render_card(result) }}
        {% endautoescape %}
        <script>
        document.querySelectorAll('.twitter-img-aspect').forEach(function(aspectWrap) {
            var gridWrap = aspectWrap.previousElementSibling;
            var row = aspectWrap.querySelector('.twitter-aspect-row');
            var imgs = Array.from(row.querySelectorAll('.twitter-aspect-item img'));
            var items = Array.from(row.querySelectorAll('.twitter-aspect-item'));
            var gap = 8;
            Promise.all(imgs.map(function(img) {
                return img.complete ? Promise.resolve() : new Promise(function(r) { img.onload = r; img.onerror = r; });
            })).then(function() {
                var allPortrait = imgs.every(function(img) { return img.naturalHeight > img.naturalWidth; });
                if (!allPortrait) return;
                gridWrap.style.display = 'none';
                aspectWrap.style.display = '';
                var availableWidth = row.clientWidth - gap * (imgs.length - 1);
                var ratios = imgs.map(function(img) { return img.naturalWidth / img.naturalHeight; });
                var commonHeight = availableWidth / ratios.reduce(function(a, b) { return a + b; }, 0);
                imgs.forEach(function(img, i) {
                    img.style.width = (ratios[i] * commonHeight) + 'px';
                    img.style.height = commonHeight + 'px';
                });
                items.forEach(function(item) {
                    item.style.flex = '0 0 auto';
                });
            });
        });
        </script>
    </body>
</html>
